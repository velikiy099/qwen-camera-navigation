<?xml version="1.0"?>
<package format="3">
  <name>pai_robot</name><version>3.0.0</version>
  <description>Vision-language verified differential-drive robot in ROS 2 Humble and Gazebo Fortress.</description>
  <maintainer email="maintainer@example.invalid">PAI project</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>std_srvs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend><exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
